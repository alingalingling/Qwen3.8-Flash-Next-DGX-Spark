# Qwen3.8-Flash-Next UD-Q3_K_XL llama-server 用户级 systemd 服务
# 安装: mkdir -p ~/.config/systemd/user && cp qwen38-q3.service ~/.config/systemd/user/
#        systemctl --user daemon-reload
#        systemctl --user enable --now qwen38-q3
# 注意: 如服务需开机自启,先执行 loginctl enable-linger $USER
[Unit]
Description=Qwen3.8-Flash-Next UD-Q3_K_XL (llama-server, qwen4exp PR branch)
After=network.target

[Service]
Type=simple
ExecStart=/home/lingyan/llama.cpp/build/bin/llama-server -m /home/lingyan/models/Qwen3.8-Flash-Next-GGUF/UD-Q3_K_XL/Qwen3.8-Flash-Next-UD-Q3_K_XL-00001-of-00003.gguf --host 0.0.0.0 --port 8889 --ctx-size 262144 -ngl 999 -t 20 --temp 0.7 --top-p 0.80 --top-k 20 --min-p 0.0 --repeat-penalty 1.0 --presence-penalty 1.5 --jinja
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
